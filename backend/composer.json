{
  "name": "novatech/api",
  "description": "NovaTech API - e-commerce en PHP puro (sin frameworks) para el proyecto de Seguridad en Aplicaciones",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": { "NovaTech\\": "src/" }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "test": "php tests/run.php",
    "stan": "phpstan analyse src --level=8",
    "audit": "composer audit"
  }
}
